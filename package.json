{
  "name": "nines",
  "version": "0.1.0",
  "private": true,
  "description": "A retro top-down RPG about growing from Junior to Senior engineer.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "validate:content": "vitest run tests/content",
    "check:dist": "node tools/check-dist.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@xterm/xterm": "6.0.0",
    "phaser": "3.90.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  }
}
