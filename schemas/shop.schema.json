{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nines.invalid/schemas/shop.schema.json",
  "title": "content/shop.yaml",
  "description": "Homelab gear for sale. Effects are the only levers the engine knows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items"],
  "properties": {
    "schema": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "description", "price", "requires", "effects"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "title": { "$ref": "common.schema.json#/$defs/localeKey" },
          "description": { "$ref": "common.schema.json#/$defs/localeKey" },
          "price": { "type": "integer", "minimum": 1, "maximum": 100000 },
          "requires": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
          "consumable": { "type": "boolean", "description": "bought again and again and never owned: its effects apply once per purchase; only tokens" },
          "effects": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "income_per_quest": { "type": "integer", "minimum": 0, "maximum": 1000 },
              "hint_boost": { "type": "integer", "minimum": 0, "maximum": 5, "description": "hints unlock this many tries sooner (asking still costs a token)" },
              "tokens": { "type": "integer", "minimum": 1, "maximum": 50, "description": "AI tokens a consumable adds per purchase" }
            }
          }
        }
      }
    }
  }
}
