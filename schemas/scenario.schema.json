{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nines.invalid/schemas/scenario.schema.json",
  "title": "scenario.yaml",
  "description": "The simulated machine behind a quest's terminal, and the conditions that win, hint and punish.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "host",
    "user",
    "home",
    "motd",
    "mounts",
    "objectives"
  ],
  "properties": {
    "schema": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "host": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "user": {
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
    },
    "home": {
      "$ref": "common.schema.json#/$defs/absPath"
    },
    "cwd": {
      "$ref": "common.schema.json#/$defs/absPath"
    },
    "motd": {
      "$ref": "common.schema.json#/$defs/localeKey"
    },
    "mounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "device",
          "size"
        ],
        "properties": {
          "path": {
            "$ref": "common.schema.json#/$defs/absPath"
          },
          "device": {
            "type": "string",
            "pattern": "^/dev/[a-z0-9/-]+$"
          },
          "size": {
            "$ref": "common.schema.json#/$defs/size"
          },
          "base_used": {
            "$ref": "common.schema.json#/$defs/size",
            "description": "space used by files the scenario does not list"
          }
        }
      }
    },
    "dirs": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/absPath"
      },
      "maxItems": 200
    },
    "files": {
      "type": "object",
      "maxProperties": 400,
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/absPath"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "maxLength": 20000
          },
          {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "size": {
                "$ref": "common.schema.json#/$defs/size"
              },
              "content": {
                "type": "string",
                "maxLength": 20000,
                "description": "the visible text; with size, the tail of a bigger file"
              }
            }
          }
        ]
      }
    },
    "services": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z0-9][a-z0-9_.@-]{0,40}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "state"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "state": {
            "enum": [
              "active",
              "inactive",
              "failed"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "logs": {
            "$ref": "#/$defs/logLines"
          },
          "restart": {
            "$ref": "#/$defs/restartRule"
          }
        }
      }
    },
    "deployments": {
      "type": "object",
      "maxProperties": 20,
      "propertyNames": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status"
        ],
        "properties": {
          "namespace": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "replicas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "status": {
            "$ref": "#/$defs/podStatus"
          },
          "restarts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 999
          },
          "logs": {
            "$ref": "#/$defs/logLines"
          },
          "restart": {
            "$ref": "#/$defs/deploymentRestart"
          },
          "image": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9./:@_-]{0,120}$",
            "description": "the container image, shown by kubectl describe pod"
          },
          "readiness_failure": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "description": "what kubectl describe pod prints for a failing readiness probe (a NotReady pod), e.g. 'HTTP probe failed with statuscode: 404'"
          },
          "config_map": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "the ConfigMap the container takes its environment from (envFrom), shown by kubectl describe pod"
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root"
      ],
      "properties": {
        "root": {
          "$ref": "common.schema.json#/$defs/absPath"
        },
        "branch": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9/_-]{0,40}$"
        },
        "pipeline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "file",
            "validator"
          ],
          "properties": {
            "file": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*$",
              "description": "relative to the git root"
            },
            "validator": {
              "enum": [
                "nines-ci"
              ]
            }
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/localeKey"
          },
          "done_when": {
            "$ref": "common.schema.json#/$defs/expr"
          },
          "procedure": {
            "type": "boolean",
            "description": "a procedure (a change ticket, a review): an independent contractor may skip it (DESIGN.md, Independent contractor)"
          },
          "check": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "file"
            ],
            "description": "a free-text file graded fairly; while it fails, the objectives panel says what is still wrong (src/sim/check.ts)",
            "anyOf": [
              {
                "properties": {
                  "fields": true
                },
                "required": [
                  "fields"
                ]
              },
              {
                "properties": {
                  "choice": true
                },
                "required": [
                  "choice"
                ]
              },
              {
                "properties": {
                  "mentions": true
                },
                "required": [
                  "mentions"
                ]
              }
            ],
            "properties": {
              "file": {
                "$ref": "common.schema.json#/$defs/absPath"
              },
              "fields": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "description": "`Name: value` lines that must be filled in; number: the value must equal it (1.25, 1,25, €1.25)",
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "pattern": "^[^\\n]+$"
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "name"
                      ],
                      "properties": {
                        "name": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40,
                          "pattern": "^[^\\n]+$"
                        },
                        "number": {
                          "type": "number"
                        }
                      }
                    }
                  ]
                }
              },
              "choice": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "field",
                  "scale",
                  "accept"
                ],
                "description": "exactly one value from scale on the field's line, and one of accept",
                "properties": {
                  "field": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "pattern": "^[^\\n]+$"
                  },
                  "scale": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z]+$"
                    }
                  },
                  "accept": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 8,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z]+$"
                    }
                  },
                  "wrong": {
                    "$ref": "common.schema.json#/$defs/localeKey"
                  }
                }
              },
              "mentions": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "any",
                    "missing"
                  ],
                  "properties": {
                    "any": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 12,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 40,
                        "pattern": "^[^\\n]+$"
                      }
                    },
                    "missing": {
                      "$ref": "common.schema.json#/$defs/localeKey",
                      "description": "what the note says while none of the words appears"
                    }
                  }
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "properties": {
              "done_when": true
            },
            "required": [
              "done_when"
            ]
          },
          {
            "properties": {
              "check": true
            },
            "required": [
              "check"
            ]
          }
        ],
        "description": "done when done_when holds and the check (if any) passes; at least one of the two"
      }
    },
    "hints": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "when": {
            "$ref": "common.schema.json#/$defs/expr"
          },
          "text": {
            "$ref": "common.schema.json#/$defs/localeKey"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "say"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "when": {
            "$ref": "common.schema.json#/$defs/expr"
          },
          "say": {
            "$ref": "common.schema.json#/$defs/localeKey"
          },
          "money": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          },
          "reset": {
            "type": "boolean",
            "description": "restore the machine to its starting state"
          },
          "set_flag": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "karma": {
            "type": "integer",
            "minimum": -50,
            "maximum": 50,
            "description": "karma change: a loss costs every time, a gain counts once per quest and event"
          }
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base",
        "factors"
      ],
      "description": "a hustle's chance of getting caught, in percent: base plus every factor whose condition holds when the job is finished, between 0 and 95; a roll seeded by the save decides (DESIGN.md, Side hustles). Only a hustle has one, and a hustle must have one",
      "properties": {
        "base": {
          "type": "integer",
          "minimum": 0,
          "maximum": 95
        },
        "factors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "when",
              "add",
              "text"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "when": {
                "$ref": "common.schema.json#/$defs/expr"
              },
              "add": {
                "type": "integer",
                "minimum": -50,
                "maximum": 95,
                "description": "percentage points added while the condition holds (negative: careful play lowers the risk)"
              },
              "text": {
                "$ref": "common.schema.json#/$defs/localeKey"
              }
            }
          }
        }
      }
    },
    "cluster": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/absPath"
      },
      "description": "manifests under files that the cluster already runs at the start; kubectl apply -f records more, and applied_contains() reads what was applied"
    },
    "quick": {
      "type": "array",
      "description": "suggested command lines for the terminal's quick-command strip; a tap fills the input line (the player still presses Enter)",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[!-~]([ -~]{0,46}[!-~ ])?$"
      }
    },
    "outage": {
      "type": "object",
      "additionalProperties": false,
      "description": "overrides the built-in consequence of rm -rf on a vital path",
      "properties": {
        "say": {
          "$ref": "common.schema.json#/$defs/localeKey"
        },
        "money": {
          "type": "integer",
          "minimum": -1000,
          "maximum": 0
        }
      }
    },
    "sessions": {
      "type": "array",
      "maxItems": 8,
      "description": "logins on the machine (who, w, last). Without a self session the player gets a default shell (src/sim/base.ts)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tty",
          "from"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "user": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,31}$"
          },
          "tty": {
            "type": "string",
            "pattern": "^(pts/[0-9]+|tty[0-9]+)$"
          },
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\n]+$"
          },
          "login": {
            "type": "string",
            "pattern": "^[0-2][0-9]:[0-5][0-9]$"
          },
          "self": {
            "type": "boolean",
            "description": "the player's own shell"
          },
          "logout": {
            "type": "string",
            "pattern": "^[0-2][0-9]:[0-5][0-9]$",
            "description": "when it ended: last shows it, who does not"
          },
          "relogin": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[^\\n]+$",
            "description": "a kiosk: logging out of this session logs straight back in as this; the shell stays"
          },
          "cover": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "flag",
              "from"
            ],
            "description": "while the carried progress flag holds, the session shows this from instead",
            "properties": {
              "flag": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "from": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "pattern": "^[^\\n]+$"
              }
            }
          }
        }
      }
    },
    "carry": {
      "type": "array",
      "maxItems": 4,
      "description": "progress flags from the save this machine starts with: flag() reads them. A hustle's caught_fine is added to the fine when the player is caught carrying it",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "flag"
        ],
        "properties": {
          "flag": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "caught_fine": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
      }
    }
  },
  "$defs": {
    "logLines": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    },
    "podStatus": {
      "enum": [
        "Running",
        "Pending",
        "CrashLoopBackOff",
        "Error",
        "ImagePullBackOff",
        "NotReady"
      ]
    },
    "restartRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "succeeds_if": {
          "$ref": "common.schema.json#/$defs/expr"
        },
        "logs_on_success": {
          "$ref": "#/$defs/logLines"
        },
        "logs_on_failure": {
          "$ref": "#/$defs/logLines"
        }
      }
    },
    "deploymentRestart": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "succeeds_if": {
          "$ref": "common.schema.json#/$defs/expr"
        },
        "logs_on_success": {
          "$ref": "#/$defs/logLines"
        },
        "logs_on_failure": {
          "$ref": "#/$defs/logLines"
        },
        "status_on_failure": {
          "$ref": "#/$defs/podStatus"
        }
      }
    }
  }
}
